# Add the needed variables to your existing .env; keep existing WeRSS credentials.
# Configure the same key in GitHub Actions Secrets for cloud classification.
CLASSIFIER_PROVIDER=hybrid
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-1.14.0
ENRICH_MAX_ITEMS=100
# Optional: local collector (credentials stay in ignored .local/).
# Use the same WECHAT_PROVIDER=local repository variable in GitHub Actions.
WECHAT_PROVIDER=werss
# WECHAT_COLLECTOR_ROOT=
# WECHAT_COLLECTOR_PYTHON=
